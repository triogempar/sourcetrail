# Nebius Token Factory (OpenAI-compatible). Required unless SOURCETRAIL_MOCK=1.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
NEBIUS_VERIFY_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_TIMEOUT_MS=40000

# Tavily. Basic search is 1 credit. Required unless SOURCETRAIL_MOCK=1.
TAVILY_API_KEY=
TAVILY_SEARCH_TIMEOUT_MS=14000
TAVILY_EXTRACT_TIMEOUT_MS=18000

# Fixture desk: no Nebius or Tavily calls. Use this to develop and screenshot.
SOURCETRAIL_MOCK=0
SOURCETRAIL_MOCK_PACE_MS=180

# Kill switch. The UI shows a paused notebook and the API refuses new questions.
SOURCETRAIL_DISABLED=0

# Abuse and cost caps. Hard ceilings are enforced in code (see README).
SOURCETRAIL_RATE_LIMIT_PER_HOUR=6
SOURCETRAIL_DAILY_CAP=24
SOURCETRAIL_MAX_TAVILY_CREDITS=8
SOURCETRAIL_MAX_QUESTION_LENGTH=500

# max_tokens on every Nebius call. Values above the code ceiling are clamped.
SOURCETRAIL_MAX_TOKENS_PLAN=700
SOURCETRAIL_MAX_TOKENS_REWRITE=160
SOURCETRAIL_MAX_TOKENS_WRITE=1600
SOURCETRAIL_MAX_TOKENS_VERIFY=1600
